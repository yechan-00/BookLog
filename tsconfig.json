{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "lib/notifications/schedulePlan.test.ts",
    "utils/readingStats.test.ts",
    "utils/shelf.test.ts",
    "utils/homeWeekStats.test.ts"
  ]
}
